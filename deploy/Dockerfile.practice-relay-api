# Practice Relay API image for production-lab compose only.
# The runtime is emitted JavaScript, not tsx. No MinIO client binary is required.
# Does not claim multi-campus HA.

FROM node:24-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

# Install the API workspace graph only (no need for MvEI Workbench browsers).
RUN pnpm install --frozen-lockfile --filter @practice-relay/relay-api...

# Emit a single Node ESM entrypoint, then copy the filtered production package.
# `deploy --prod` retains the workspace runtime dependency graph without root dev tools.
RUN pnpm --filter @practice-relay/relay-api run build \
  && pnpm --filter @practice-relay/relay-api deploy --prod /opt/practice-relay-api

FROM node:24-bookworm-slim

WORKDIR /app

COPY --from=build /opt/practice-relay-api ./

ENV NODE_ENV=production
ENV PORT=8787
EXPOSE 8787

COPY deploy/docker-entrypoint-practice-relay-api.sh /usr/local/bin/docker-entrypoint-practice-relay-api.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-practice-relay-api.sh

ENTRYPOINT ["docker-entrypoint-practice-relay-api.sh"]
CMD ["node", "dist/index.mjs"]
