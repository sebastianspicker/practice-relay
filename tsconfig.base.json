{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@practice-relay/work-record": [
        "packages/work-record/src/index.ts"
      ],
      "@practice-relay/work-record/time": [
        "packages/work-record/src/time/index.ts"
      ],
      "@practice-relay/work-record/policy": [
        "packages/work-record/src/policy/index.ts"
      ],
      "@practice-relay/work-record/media": [
        "packages/work-record/src/media/index.ts"
      ],
      "@practice-relay/handoff": [
        "packages/handoff/src/index.ts"
      ],
      "@practice-relay/movement": [
        "packages/movement/src/index.ts"
      ],
      "@practice-relay/movement/browser": [
        "packages/movement/browser/index.mjs"
      ],
      "@practice-relay/movement-toolkit": [
        "packages/movement-toolkit/src/index.ts"
      ],
      "@practice-relay/auth": [
        "packages/auth/src/index.ts"
      ],
      "@practice-relay/media-store": [
        "packages/media-store/src/index.ts"
      ],
      "@practice-relay/record-store": [
        "packages/record-store/src/index.ts"
      ],
      "@practice-relay/relay-api": [
        "apps/relay-api/src/index.ts"
      ],
      "@practice-relay/movement/glyphs": [
        "packages/movement/glyphs/index.ts"
      ],
      "@practice-relay/database": [
        "packages/database/src/index.ts"
      ],
      "@practice-relay/runtime-state": [
        "packages/runtime-state/src/index.ts"
      ],
      "@practice-relay/movement/browser/*": [
        "packages/movement/browser/*.mjs"
      ]
    },
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "**/.env*",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codacy/**",
    "**/.codegraph/**",
    "**/.codex/**",
    "**/.cursor/**",
    "**/.git/**",
    "**/.grok/**",
    "**/.idea/**",
    "**/.pnpm-store/**",
    "**/.scratch/**",
    "**/.serena/**",
    "**/.turbo/**",
    "**/.vite/**",
    "**/.vscode/**",
    "**/certificates/**",
    "data/**",
    "**/deploy/secrets/**",
    "**/dist/**",
    "**/keys/**",
    "**/logs/**",
    "**/node_modules/**",
    "**/secrets/**",
    "**/tmp/**"
  ]
}
