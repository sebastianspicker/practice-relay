{
  "schemaVersion": "0.1.0",
  "kind": "practice-relay-canvas-lti-tool-config",
  "status": "not-production",
  "preflight": true,
  "disclaimer": "PREFLIGHT ONLY - shaped for Canvas Developer Key / LTI 1.3 registration fields. Not proof of a completed Canvas install. Not IMS certified. MOCK PLATFORM - not Canvas.",
  "lms": "canvas",
  "adminPath": "Admin → Developer Keys → + LTI Key (LTI 1.3)",
  "tool": {
    "title": "Practice Relay",
    "description": "Multi-asset WorkRecord package assignment for local evaluation before external LMS registration.",
    "target_link_uri": "http://localhost:8787/lti/launch",
    "openid_connect_initiation_url": "http://localhost:8787/lti/login",
    "redirect_uris": [
      "http://localhost:8787/lti/launch"
    ],
    "public_jwk_url": "http://localhost:8787/lti/jwks",
    "jwk_method": "public_jwk_url",
    "client_id": "REPLACE_WITH_CANVAS_CLIENT_ID",
    "deployment_id": "REPLACE_WITH_CANVAS_DEPLOYMENT_ID",
    "issuer": "REPLACE_WITH_CANVAS_ISSUER",
    "issuer_examples": [
      "https://canvas.instructure.com",
      "https://school.instructure.com"
    ],
    "custom_fields": {
      "asset_mode": "multi-asset",
      "practice_relay_assignment": "embedded JSON at launch; singleVideoUrl always null"
    }
  },
  "extensions": {
    "assignment_and_grade_services": {
      "enabled": true,
      "scopes": [
        "https://purl.imsglobal.org/spec/lti-ags/scope/lineitem",
        "https://purl.imsglobal.org/spec/lti-ags/scope/score"
      ],
      "optional_scopes": [
        "https://purl.imsglobal.org/spec/lti-ags/scope/lineitem.readonly",
        "https://purl.imsglobal.org/spec/lti-ags/scope/result.readonly"
      ],
      "note": "Production AGS token URL and line items are hosted by Canvas, not by the Practice Relay lab mock /lti/oauth/token."
    },
    "privacy_level": "public",
    "placements": [
      "assignment_selection",
      "course_navigation"
    ]
  },
  "productionHostRewrite": {
    "from": "http://localhost:8787",
    "to": "https://practice-relay.example.edu",
    "fields": [
      "tool.target_link_uri",
      "tool.openid_connect_initiation_url",
      "tool.redirect_uris",
      "tool.public_jwk_url"
    ]
  },
  "assignmentContract": {
    "kind": "practice-relay-multi-asset-assignment",
    "assetMode": "multi-asset",
    "singleVideoUrl": null
  },
  "envAfterRegistration": {
    "PRACTICE_RELAY_LTI_CLIENT_ID": "from Canvas Client ID",
    "PRACTICE_RELAY_LTI_PLATFORM_ISS": "from Canvas Issuer",
    "PRACTICE_RELAY_LTI_PLATFORM_AUTH_URL": "from Canvas OIDC auth endpoint",
    "PRACTICE_RELAY_LTI_KEYS_DIR": "required for RS256 + public_jwk_url",
    "PRACTICE_RELAY_LTI_SECRET": "retain for AGS lab dual-mode / service tokens as configured"
  },
  "docs": {
    "preflight": "practice-relay/docs/lms-registration-preflight.md",
    "registration": "practice-relay/docs/lti-lms-registration.md",
    "localEvaluationGuide": "practice-relay/docs/lab-only-tier.md"
  }
}
