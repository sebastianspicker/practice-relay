{
  "schemaVersion": "0.1.0",
  "kind": "practice-relay-moodle-lti-tool-config",
  "status": "not-production",
  "preflight": true,
  "disclaimer": "PREFLIGHT ONLY - shaped for Moodle External tool / LTI 1.3 Advantage registration fields. Not proof of a completed Moodle install. Not IMS certified. MOCK PLATFORM - not Canvas.",
  "lms": "moodle",
  "adminPath": "Site admin → Plugins → Activity modules → External tool → Manage tools → Configure a tool manually (LTI 1.3)",
  "tool": {
    "name": "Practice Relay",
    "description": "Multi-asset WorkRecord package assignment for local evaluation before external LMS registration.",
    "tool_url": "http://localhost:8787/lti/launch",
    "initiate_login_url": "http://localhost:8787/lti/login",
    "redirection_uris": [
      "http://localhost:8787/lti/launch"
    ],
    "public_keyset_url": "http://localhost:8787/lti/jwks",
    "public_key_type": "keyset_url",
    "client_id": "REPLACE_WITH_MOODLE_CLIENT_ID",
    "deployment_id": "REPLACE_WITH_MOODLE_DEPLOYMENT_ID",
    "platform_id": "REPLACE_WITH_MOODLE_PLATFORM_ID",
    "issuer": "REPLACE_WITH_MOODLE_ISSUER",
    "issuer_example": "https://moodle.example.edu",
    "custom_parameters": {
      "asset_mode": "multi-asset",
      "practice_relay_assignment": "embedded JSON at launch; singleVideoUrl always null"
    }
  },
  "services": {
    "ims_lti_assignment_and_grade_services": {
      "enabled": true,
      "scopes": [
        "https://purl.imsglobal.org/spec/lti-ags/scope/lineitem",
        "https://purl.imsglobal.org/spec/lti-ags/scope/score"
      ],
      "optional_scopes": [
        "https://purl.imsglobal.org/spec/lti-ags/scope/lineitem.readonly",
        "https://purl.imsglobal.org/spec/lti-ags/scope/result.readonly"
      ],
      "note": "Production AGS endpoints are hosted by Moodle. Practice Relay /lti/oauth/token and /lti/ags/scores are local test doubles."
    },
    "ims_lti_names_role_provisioning": {
      "enabled": false,
      "note": "Not required for multi-asset assignment residual."
    }
  },
  "privacy": {
    "share_launcher_name": "always",
    "share_launcher_email": "always",
    "accept_grades_from_tool": true
  },
  "productionHostRewrite": {
    "from": "http://localhost:8787",
    "to": "https://practice-relay.example.edu",
    "fields": [
      "tool.tool_url",
      "tool.initiate_login_url",
      "tool.redirection_uris",
      "tool.public_keyset_url"
    ]
  },
  "assignmentContract": {
    "kind": "practice-relay-multi-asset-assignment",
    "assetMode": "multi-asset",
    "singleVideoUrl": null
  },
  "envAfterRegistration": {
    "PRACTICE_RELAY_LTI_CLIENT_ID": "from Moodle client id",
    "PRACTICE_RELAY_LTI_PLATFORM_ISS": "from Moodle issuer / platform id",
    "PRACTICE_RELAY_LTI_PLATFORM_AUTH_URL": "from Moodle OIDC auth endpoint",
    "PRACTICE_RELAY_LTI_KEYS_DIR": "required for RS256 + public_keyset_url",
    "PRACTICE_RELAY_LTI_SECRET": "retain as configured for dual-mode"
  },
  "docs": {
    "preflight": "practice-relay/docs/lms-registration-preflight.md",
    "registration": "practice-relay/docs/lti-lms-registration.md",
    "localEvaluationGuide": "practice-relay/docs/lab-only-tier.md"
  }
}
