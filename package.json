{
  "name": "practice-relay",
  "private": true,
  "type": "module",
  "version": "0.4.0-alpha.1",
  "description": "Practice Relay prepares policy-aware WorkRecord handoffs; MvEI and MvEI Workbench remain separate movement-schema and authoring surfaces.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "node scripts/code-quality-check.mjs",
    "validate:schemas": "node --import tsx scripts/validate-schemas.ts",
    "validate:evidence": "node --import tsx scripts/validate-evidence.ts",
    "validate:docs": "node scripts/validate-doc-links.mjs",
    "verify:public-hygiene": "node scripts/verify-public-hygiene.mjs",
    "verify:public-hygiene:strict": "node scripts/verify-public-hygiene.mjs --strict",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "quality:check": "node scripts/code-quality-check.mjs",
    "verify:core": "pnpm typecheck && pnpm build && pnpm quality:check && pnpm validate:schemas && pnpm validate:docs && pnpm validate:evidence && pnpm test",
    "release:check": "pnpm verify:core && pnpm verify:public-hygiene",
    "release:check:strict": "pnpm release:check && pnpm verify:public-hygiene:strict",
    "demo:render-html": "node scripts/render-alpha-html.mjs",
    "publish:dry-run": "node scripts/publish-dry-run.mjs",
    "corpus:site": "node packages/movement-encode/scripts/generate-corpus-site.mjs"
  },
  "devDependencies": {
    "@practice-relay/work-record-core": "workspace:*",
    "@practice-relay/work-record-package": "workspace:*",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "keywords": [
    "practice-relay",
    "work-record",
    "work-record-core",
    "mvei",
    "mvei-workbench",
    "movement-encoding",
    "institutional-handoff",
    "ro-crate"
  ]
}
