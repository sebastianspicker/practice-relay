# Practice Relay API (apps/relay-api), loopback development only
PRACTICE_RELAY_HOST=127.0.0.1
PORT=8787
PRACTICE_RELAY_ALLOW_SYNTHETIC_AUTH=1
# Set to 1 in deployments that must refuse traffic without durable record storage.
PRACTICE_RELAY_REQUIRE_DURABLE=0

# Multiple API processes require postgres and shared coordination.
PRACTICE_RELAY_TOPOLOGY=single-process
# PRACTICE_RELAY_STORE=postgres
# Set PRACTICE_RELAY_DATABASE_URL privately; run migrations explicitly.
# Across hosts use S3; filesystem requires an explicit shared host.
PRACTICE_RELAY_MEDIA_SHARED_HOST=0
