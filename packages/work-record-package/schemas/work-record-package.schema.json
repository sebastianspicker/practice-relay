{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:practice-relay:schema:work-record-package:0.4",
  "title": "work-record package WorkRecord Package Manifest",
  "description": "RO-Crate 1.3-aligned performing-arts process profile (domain profile, not a new packaging invention)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "workRecordId",
    "title",
    "tracks",
    "takes",
    "consentSummary"
  ],
  "properties": {
    "schemaVersion": { "const": "0.4" },
    "profile": {
      "const": "urn:practice-relay:profile:work-record-package:0.4"
    },
    "workRecordId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "preferredTakeId": { "type": ["string", "null"] },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "audio",
              "video",
              "music_notation",
              "movement_annotation",
              "movement_notation",
              "media_cues",
              "text",
              "assessment",
              "analysis"
            ]
          },
          "label": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    },
    "takes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "mediaPath": { "type": "string" }
        }
      }
    },
    "consentSummary": {
      "type": "object",
      "required": ["allTagged", "purposes"],
      "properties": {
        "allTagged": { "type": "boolean" },
        "purposes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exportFiltered": { "type": "boolean" }
      }
    },
    "musicxmlRef": { "type": ["string", "null"] },
    "mveiRef": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    }
  }
}
