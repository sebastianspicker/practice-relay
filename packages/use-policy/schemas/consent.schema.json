{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mac-research.local/schemas/consent/v0.1.json",
  "title": "ConsentRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "subjectId", "purposes", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "course_assessment",
          "formative_feedback",
          "research_archive",
          "public_showcase",
          "model_training_forbidden",
          "plugin_analysis"
        ]
      }
    },
    "biometricRisk": {
      "type": "boolean",
      "description": "True if Art. 9 special-category risk may apply (face, gait, mocap)"
    },
    "retentionUntil": { "type": ["string", "null"], "format": "date" },
    "exportAllowed": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
