{
  "name": "@practice-relay/mvei-validator",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "CLI validator for MvEI Motif / laban-subset / annotation fixtures",
  "main": "./src/cli.ts",
  "types": "./src/cli.ts",
  "exports": {
    ".": {
      "types": "./src/cli.ts",
      "import": "./src/cli.ts",
